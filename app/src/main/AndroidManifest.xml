<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Alarms are cleared by a reboot; re-arm the complication refresh chain on boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            directBootAware: until the watch is unlocked after a reboot the system will not
            bind a component that is not marked here, so the watch face drew this slot empty
            while every built-in complication was already filled. Safe because nothing on the
            complication path reads app storage - the schedule is a compiled-in table.
        -->
        <service
            android:name=".complication.PeriodComplicationService"
            android:directBootAware="true"
            android:exported="true"
            android:icon="@drawable/ic_school"
            android:label="@string/complication_label"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>

            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,RANGED_VALUE,LONG_TEXT,GOAL_PROGRESS" />
            <!--
                Only a safety net. The platform treats this as a throttled hint, so the
                countdown does not rely on it: the text is a time reference the watch face
                renders itself, and period changes are refreshed on the bell by
                ComplicationRefreshReceiver.
            -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="300" />
        </service>

        <receiver
            android:name=".complication.ComplicationRefreshReceiver"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.shieldrj.schoolperiod.action.REFRESH_COMPLICATION" />
            </intent-filter>
            <intent-filter>
                <!--
                    LOCKED_BOOT_COMPLETED arrives before the unlock; BOOT_COMPLETED only after
                    it. Both are listened for so the refresh chain re-arms at the earlier of
                    the two, and the second is a harmless repeat of the same work.
                -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>

